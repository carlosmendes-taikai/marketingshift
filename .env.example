# Marketingshift environment. Copy to .env.local and fill in what you need:
#   cp .env.example .env.local
#
# Everything is optional. With no key, Marketingshift runs fully offline using the
# built-in keyword classifier ("jev-offline"), so the app works out of the box.

# Vercel AI Gateway key. When set, intent classification uses TypeSafe's Jev model
# through the gateway. Create one at https://vercel.com/dashboard → AI Gateway → API keys.
# Server-side only; never exposed to the browser. On Vercel, the project's OIDC token also works.
AI_GATEWAY_API_KEY=

# The Jev model id on the AI Gateway.
JEV_MODEL=typesafe-ai/jev

# Force the offline classifier even when a key is set (handy for UI work and demos).
NEXT_PUBLIC_USE_MOCK=false

# Public URL, used for Open Graph metadata when deployed.
# NEXT_PUBLIC_SITE_URL=https://marketingshift.example.com
